# Docker images
FRONTEND_IMAGE=ghcr.io/rythmez/film-react-nest/frontend:latest
BACKEND_IMAGE=ghcr.io/rythmez/film-react-nest/backend:latest
NGINX_IMAGE=ghcr.io/rythmez/film-react-nest/nginx:latest

# Gateway
HTTP_PORT=8080

# Frontend build-time settings
VITE_API_URL=/api/afisha
VITE_CDN_URL=/content/afisha

# Backend
NODE_ENV=production
DATABASE_DRIVER=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
LOG_FORMAT=json

# PostgreSQL
POSTGRES_DB=student
POSTGRES_USER=student
POSTGRES_PASSWORD=replace-with-a-strong-password

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password
PGADMIN_PORT=5050
