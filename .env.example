# Docker images
FRONTEND_IMAGE=ghcr.io/rythmez/film-react-nest/frontend:latest
BACKEND_IMAGE=ghcr.io/rythmez/film-react-nest/backend:latest
NGINX_IMAGE=ghcr.io/rythmez/film-react-nest/nginx:latest

# Gateway
HTTP_PORT=8080

# Frontend build-time settings
VITE_API_URL=https://api.film-film-film.nomorepartiessite.ru/api/afisha
VITE_CDN_URL=https://api.film-film-film.nomorepartiessite.ru/content/afisha

# Backend
NODE_ENV=production
PORT=3000
DATABASE_DRIVER=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
LOG_FORMAT=json

# PostgreSQL
POSTGRES_DB=student
POSTGRES_USER=student
POSTGRES_PASSWORD=strong-password

# PgAdmin
PGADMIN_DEFAULT_EMAIL=artamonov4work@yandex.ru
PGADMIN_DEFAULT_PASSWORD=strong-password
PGADMIN_PORT=5050
